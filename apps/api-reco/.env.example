# Same database as api-core is fine: this service only writes to the `reco` schema.
# Prisma-style URLs (postgresql://...?schema=public) are accepted too.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/withyou
# Database holding the api-core (Prisma) tables, read by scripts/sync_core.py.
# Defaults to DATABASE_URL when empty.
CORE_DATABASE_URL=

ENVIRONMENT=dev
LOG_LEVEL=INFO
CATALOG_REFRESH_SECONDS=60
SEED_REFERENCE_ON_STARTUP=true
# Required by /api/v1/admin/* (header X-Admin-Token). Admin routes are disabled when empty.
ADMIN_TOKEN=change-me
CORS_ORIGINS=["http://localhost:3000"]

# V3 only: directory of a trained Learning-to-Rank model (see app/ml/train.py).
LTR_MODEL_PATH=
# Optional: MLflow tracking (pip install -r requirements-ml.txt)
MLFLOW_TRACKING_URI=file:./mlruns
